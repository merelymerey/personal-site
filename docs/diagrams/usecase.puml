@startuml usecase
left to right direction
skinparam packageStyle rectangle
skinparam shadowing false

actor "Visitor\n(teacher, recruiter,\nclassmate)" as V
actor "Site owner" as O

rectangle "Personal website" {
  usecase "Read introduction" as UC1
  usecase "Switch language\n(KK / RU / EN)" as UC2
  usecase "View education and\nlearning portfolio" as UC3
  usecase "View projects" as UC4
  usecase "Open external\nproject link" as UC4a
  usecase "View activities\nand future plans" as UC5
  usecase "Send contact message" as UC6
  usecase "Validate input" as UC6a
  usecase "Read privacy statement" as UC7
  usecase "Read stored messages\n(hosting file manager)" as UC8
  usecase "Update content\nand redeploy" as UC9
}

V --> UC1
V --> UC2
V --> UC3
V --> UC4
V --> UC5
V --> UC6
V --> UC7
UC4 <.. UC4a : <<extend>>
UC6 ..> UC6a : <<include>>
O --> UC8
O --> UC9
@enduml
